NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wms_dev
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# WMS credentials encryption (AES-256-CBC — exactly 32 chars in prod)
WMS_ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHAR_KEY_000000
